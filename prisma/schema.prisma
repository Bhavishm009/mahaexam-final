  exam           Exam?            @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([studentId, readAt, createdAt])
  @@index([organizationId, createdAt])
}

model Payment {
  id                      String                 @id @default(cuid())
  userId                  String?
  organizationId          String?
  subscriptionId          String?
  studentId               String?
  examId                  String?
  provider                PaymentProvider        @default(RAZORPAY)
  providerPaymentId       String?
  providerOrderId         String?
  orderId                 String?                @unique
  paymentId               String?                @unique
  razorpayOrderId         String?                @unique
  razorpayPaymentId       String?                @unique
  razorpaySignature       String?
  signature               String?
  amount                  Float                  @default(0)
  amountPaise             Int?
  currency                String                 @default("INR")
  status                  PaymentStatus          @default(CREATED)
  paymentType             String?
  metadata                Json?
  rawResponse             Json?
  receipt                 String?                @unique
  failureReason           String?
  refundId                String?
  verifiedAt              DateTime?
  paidAt                  DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  user                    User?                  @relation("PaymentUser", fields: [userId], references: [id], onDelete: SetNull)
  organization            Organization?          @relation("PaymentOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  subscription            CoachingSubscription?  @relation("PaymentSubscription", fields: [subscriptionId], references: [id], onDelete: SetNull)
  student                 User?                  @relation("PaymentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  exam                    Exam?                  @relation("PaymentExam", fields: [examId], references: [id], onDelete: Restrict)
  marketplaceTransfers    MarketplaceTransfer[]
  payoutAccount           CoachingPayoutAccount? @relation(fields: [coachingPayoutAccountId], references: [id])
  coachingPayoutAccountId String?

  @@index([userId, status])
  @@index([studentId, status])
  @@index([organizationId, status])
  @@index([examId, status])
  @@index([providerPaymentId])
}

