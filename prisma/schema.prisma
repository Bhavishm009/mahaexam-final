generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COACHING_ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum CoachingStatus {
  INDIVIDUAL
  COACHING
}

enum BatchStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  TRUE_FALSE
  DESCRIPTIVE
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  ARCHIVED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EXPIRED
}

enum ViolationType {
  TAB_SWITCH
  WINDOW_BLUR
  FULLSCREEN_EXIT
  COPY_ATTEMPT
  PASTE_ATTEMPT
  RIGHT_CLICK
}

enum AccessStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model Organization {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String                  @unique
  email                 String?
  phone                 String?
  address               String?
  district              String?
  state                 String                  @default("Maharashtra")
  status                OrganizationStatus      @default(ACTIVE)
  subscriptionPlan      String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  users                 User[]
  batches               Batch[]
  coachingBatches       CoachingBatch[]
  questions             Question[]
  exams                 Exam[]
  notifications         Notification[]
  payments              Payment[]               @relation("PaymentOrganization")
  subscriptions         Subscription[]
  coachingSubscriptions CoachingSubscription[]
  teacherProfiles       TeacherProfile[]
  auditLogs             AuditLog[]
  questionBankQuestions QuestionBankQuestion[]
  examDrafts            ExamDraft[]
  calendarEvents        ExamCalendarEvent[]
  paymentOrders         PaymentOrder[]
  coachingAuditLogs     CoachingAuditLog[]
  coachingNotifications CoachingNotification[]
  questionImportBatches QuestionImportBatch[]
  questionShareGrants   QuestionShareGrant[]
  examAggregates        CoachingExamAggregate[]
  coachingExamProducts  CoachingExamProduct[]
  marketplaceTransfers  MarketplaceTransfer[]
  payoutAccount         CoachingPayoutAccount?
  coachingInvites       CoachingInvite[]
}

model User {
  id                         String                      @id @default(cuid())
  organizationId             String?
  name                       String
  email                      String?                     @unique
  phone                      String?                     @unique
  passwordHash               String?
  role                       UserRole
  status                     UserStatus                  @default(ACTIVE)
  preferredLanguage          String                      @default("en")
  lastLoginAt                DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  organization               Organization?               @relation(fields: [organizationId], references: [id])
  studentProfile             StudentProfile?
  teacherProfile             TeacherProfile?
  batchesTaught              Batch[]                     @relation("BatchTeacher")
  questionsCreated           Question[]                  @relation("QuestionCreator")
  examsCreated               Exam[]                      @relation("ExamCreator")
  attempts                   ExamAttempt[]               @relation("ExamAttemptStudent")
  results                    Result[]                    @relation("ResultStudent")
  notifications              Notification[]              @relation("NotificationUser")
  purchases                  Purchase[]
  payments                   Payment[]                   @relation("PaymentUser")
  studentPayments            Payment[]                   @relation("PaymentStudent")
  studentNotificationsLegacy Notification[]              @relation("NotificationStudent")
  examAssignments            ExamStudent[]
  violations                 ExamViolation[]
  sessions                   AuthSession[]
  examResults                ExamResult[]                @relation("ExamResultStudent")
  resultSummaries            ExamResultSummary[]         @relation("ExamResultSummaryStudent")
  examPurchases              ExamPurchase[]              @relation("ExamPurchaseUser")
  auditLogs                  AuditLog[]
  emailDeliveries            EmailDelivery[]
  createdQuestions           QuestionBankQuestion[]
  examDraftsCreated          ExamDraft[]
  examDraftStudents          ExamDraftStudent[]
  examNotifications          ExamNotification[]
  attemptEvents              ExamAttemptEvent[]
  paymentOrders              PaymentOrder[]
  coachingAuditLogs          CoachingAuditLog[]
  studentNotifications       StudentNotification[]
  questionImportBatches      QuestionImportBatch[]
  questionShareGrantsGranted QuestionShareGrant[]
  examPublishAudits          ExamPublishAudit[]
  leaderboardEntries         ExamLeaderboard[]
  performanceSnapshot        StudentPerformanceSnapshot?
  examEntitlements           ExamEntitlement[]           @relation("ExamEntitlementStudent")
  batchMemberships           BatchMembership[]
  pushSubscriptions          PushSubscription[]
}

model StudentProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  education      String?
  dateOfBirth    DateTime?
  district       String?
  taluka         String?
  targetExam     String?
  profilePhoto   String?
  coachingStatus CoachingStatus @default(INDIVIDUAL)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchStudents  BatchStudent[]
  results        Result[]
}

model TeacherProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Batch {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  examType       String
  description    String?
  teacherId      String?
  startDate      DateTime
  endDate        DateTime?
  status         BatchStatus      @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teacher        User?            @relation("BatchTeacher", fields: [teacherId], references: [id])
  students       BatchStudent[]
  exams          ExamBatch[]
  examDrafts     ExamDraftBatch[]
}

model BatchStudent {
  id        String         @id @default(cuid())
  batchId   String
  studentId String
  joinedAt  DateTime       @default(now())
  batch     Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
}

model Subject {
  id             String              @id @default(cuid())
  name           String              @unique
  nameMr         String
  slug           String              @unique
  description    String?
  status         ContentStatus       @default(PUBLISHED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  topics         Topic[]
  questions      Question[]
  resultRows     ResultSubject[]
  subjectResults SubjectResult[]
  chapters       Chapter[]
  resultSubjects ExamResultSubject[]
}

model Question {
  id                 String                @id @default(cuid())
  organizationId     String?
  subjectId          String
  topicId            String?
  questionType       QuestionType          @default(MCQ_SINGLE)
  questionText       String
  questionTextMr     String?
  explanation        String?
  explanationMr      String?
  difficulty         Difficulty            @default(MEDIUM)
  marks              Float                 @default(1)
  negativeMarks      Float                 @default(0)
  status             ContentStatus         @default(DRAFT)
  createdBy          String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  organization       Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject            Subject               @relation(fields: [subjectId], references: [id])
  topic              Topic?                @relation(fields: [topicId], references: [id])
  creator            User                  @relation("QuestionCreator", fields: [createdBy], references: [id])
  options            QuestionOption[]
  examQuestions      ExamQuestion[]
  attemptAnswers     AttemptAnswer[]
  chapter            Chapter?              @relation(fields: [chapterId], references: [id])
  questionTags       QuestionTagMap[]
  bankQuestion       QuestionBankQuestion?
  chapterId          String?
  examDraftQuestions ExamDraftQuestion[]
  visibilityMode     ExamVisibility        @default(COACHING)
  createdById        String?
  shareGrants        QuestionShareGrant[]
  attemptQuestions   AttemptQuestion[]
  examAttemptAnswers ExamAttemptAnswer[]
}

model QuestionOption {
  id             String              @id @default(cuid())
  questionId     String
  optionText     String
  optionTextMr   String?
  optionOrder    Int
  isCorrect      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  question       Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptAnswers ExamAttemptAnswer[]
}

model Exam {
  id                  String                   @id @default(cuid())
  organizationId      String?
  title               String
  slug                String                   @unique
  description         String?
  examType            String
  language            String                   @default("mr")
  durationMinutes     Int
  totalQuestions      Int
  totalMarks          Float
  negativeMarks       Float                    @default(0)
  passingScore        Float?
  randomizeQuestions  Boolean                  @default(false)
  randomizeOptions    Boolean                  @default(false)
  fullscreenRequired  Boolean                  @default(true)
  violationThreshold  Int                      @default(3)
  attemptLimit        Int                      @default(1)
  startAt             DateTime?
  endAt               DateTime?
  status              ExamStatus               @default(DRAFT)
  createdBy           String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organization        Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator             User                     @relation("ExamCreator", fields: [createdBy], references: [id])
  questions           ExamQuestion[]
  batches             ExamBatch[]
  students            ExamStudent[]
  attempts            ExamAttempt[]            @relation("ExamAttemptExam")
  results             Result[]                 @relation("ResultExam")
  purchases           Purchase[]
  examNotifications   ExamNotification[]
  notifications       Notification[]
  calendarEvents      ExamCalendarEvent[]
  resultSummaries     ExamResultSummary[]      @relation("ExamResultSummaryExam")
  paymentOrders       PaymentOrder[]
  visibilityMode      ExamVisibility           @default(COACHING)
  isFree              Boolean                  @default(false)
  price               Float                    @default(0)
  globalNotifications GlobalExamNotification[]
  questionSnapshots   ExamQuestionSnapshot[]
  sections            ExamSection[]
  questionPools       ExamQuestionPool[]
  publishAudits       ExamPublishAudit[]
  frozenAt            DateTime?
  leaderboards        ExamLeaderboard[]
  coachingAggregates  CoachingExamAggregate[]
  entitlements        ExamEntitlement[]
  payments            Payment[]                @relation("PaymentExam")
  batchAssignments    BatchExamAssignment[]
  coachingProduct     CoachingExamProduct?
  examResults         ExamResult[]             @relation("ExamResultExam")
  examPurchaseRecords ExamPurchase[]           @relation("ExamPurchaseExam")
}

model ExamQuestion {
  id            String    @id @default(cuid())
  examId        String
  questionId    String
  questionOrder Int
  marks         Float
  negativeMarks Float
  exam          Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  question      Question? @relation(fields: [questionId], references: [id])

  @@unique([examId, questionId])
}

model ExamBatch {
  id      String @id @default(cuid())
  examId  String
  batchId String
  exam    Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([examId, batchId])
}

model ExamStudent {
  id        String @id @default(cuid())
  examId    String
  studentId String
  exam      Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
}

model ExamAttempt {
  id                String              @id @default(cuid())
  examId            String
  studentId         String
  startedAt         DateTime
  expiresAt         DateTime?
  submittedAt       DateTime?
  status            AttemptStatus       @default(IN_PROGRESS)
  totalQuestions    Int                 @default(0)
  answeredQuestions Int                 @default(0)
  score             Float?
  percentage        Float?
  timeTakenSeconds  Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lastActivityAt    DateTime?
  exam              Exam                @relation("ExamAttemptExam", fields: [examId], references: [id])
  student           User                @relation("ExamAttemptStudent", fields: [studentId], references: [id])
  questions         AttemptQuestion[]
  answers           AttemptAnswer[]
  violations        ExamViolation[]
  result            Result?
  examResult        ExamResult?         @relation("ExamResultAttempt")
  secureAnswers     ExamAttemptAnswer[]
  events            ExamAttemptEvent[]
  resultSummary     ExamResultSummary?  @relation("ExamResultSummaryAttempt")

  @@index([examId, studentId])
}

model AttemptQuestion {
  id              String      @id @default(cuid())
  attemptId       String
  questionId      String?
  questionOrder   Int         @default(0)
  position        Int         @default(0)
  sectionName     String?
  snapshot        Json?
  selectedOption  String?
  markedForReview Boolean     @default(false)
  answeredAt      DateTime?
  marks           Float       @default(1)
  negativeMarks   Float       @default(0)
  attempt         ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question?   @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model AttemptAnswer {
  id               String      @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  answeredAt       DateTime?
  timeSpentSeconds Int         @default(0)
  isCorrect        Boolean?
  marksObtained    Float?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  attempt          ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model ExamViolation {
  id        String        @id @default(cuid())
  attemptId String
  type      ViolationType
  timestamp DateTime      @default(now())
  metadata  Json?
  attempt   ExamAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id])
  userId    String?

  @@index([attemptId, timestamp])
}

model Result {
  id               String          @id @default(cuid())
  attemptId        String          @unique
  studentId        String
  examId           String
  score            Float
  percentage       Float
  correctCount     Int
  wrongCount       Int
  unansweredCount  Int
  timeTakenSeconds Int
  rank             Int?
  createdAt        DateTime        @default(now())
  attempt          ExamAttempt     @relation(fields: [attemptId], references: [id])
  student          User            @relation("ResultStudent", fields: [studentId], references: [id])
  exam             Exam            @relation("ResultExam", fields: [examId], references: [id])
  subjectRows      ResultSubject[]
  studentProfile   StudentProfile? @relation(fields: [studentProfileId], references: [id])
  studentProfileId String?
}

model ResultSubject {
  id              String  @id @default(cuid())
  resultId        String
  subjectId       String
  correctCount    Int
  wrongCount      Int
  unansweredCount Int
  score           Float
  percentage      Float
  result          Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject         Subject @relation(fields: [subjectId], references: [id])

  @@unique([resultId, subjectId])
}

model Purchase {
  id           String       @id @default(cuid())
  userId       String
  examId       String?
  productName  String
  amount       Float
  paymentId    String
  accessStatus AccessStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  expiresAt    DateTime?
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam         Exam?        @relation(fields: [examId], references: [id])
}

model Subscription {
  id                     String       @id @default(cuid())
  organizationId         String
  plan                   String
  status                 String
  provider               String       @default("razorpay")
  providerSubscriptionId String?
  studentLimit           Int
  amount                 Float
  currency               String       @default("INR")
  startedAt              DateTime
  renewalAt              DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExamResult {
  id                 String            @id @default(cuid())
  attemptId          String            @unique
  examId             String
  studentId          String
  score              Float
  percentage         Float
  rank               Int?
  percentile         Float?
  correctCount       Int
  wrongCount         Int
  unansweredCount    Int
  timeTakenSeconds   Int
  passed             Boolean?
  obtainedMarks      Float             @default(0)
  totalMarks         Float             @default(0)
  accuracy           Float             @default(0)
  correct            Int               @default(0)
  wrong              Int               @default(0)
  unanswered         Int               @default(0)
  publishedAt        DateTime?
  evaluatedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  attempt            ExamAttempt       @relation("ExamResultAttempt", fields: [attemptId], references: [id], onDelete: Cascade)
  exam               Exam              @relation("ExamResultExam", fields: [examId], references: [id], onDelete: Cascade)
  student            User              @relation("ExamResultStudent", fields: [studentId], references: [id], onDelete: Cascade)
  subjects           SubjectResult[]
  leaderboardEntries ExamLeaderboard[]

  @@index([examId, score])
}

model SubjectResult {
  id              String     @id @default(cuid())
  resultId        String
  subjectId       String
  totalQuestions  Int
  correctCount    Int
  wrongCount      Int
  unansweredCount Int
  score           Float
  percentage      Float
  result          ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject         Subject    @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([resultId, subjectId])
}

model SubscriptionPlan {
  id            String                 @id @default(cuid())
  name          String
  slug          String                 @unique
  description   String?
  price         Float
  billingPeriod BillingPeriod          @default(MONTHLY)
  maxStudents   Int?
  maxBatches    Int?
  maxExams      Int?
  features      Json?
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  subscriptions CoachingSubscription[]
}

model CoachingSubscription {
  id                     String             @id @default(cuid())
  organizationId         String
  planId                 String
  status                 SubscriptionStatus @default(PENDING)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  razorpaySubscriptionId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments               Payment[]          @relation("PaymentSubscription")

  @@index([organizationId, status])
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  status      JobStatus @default(PENDING)
  payload     Json
  attempts    Int       @default(0)
  runAt       DateTime  @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAt])
}

model EmailDelivery {
  id         String      @id @default(cuid())
  userId     String?
  email      String
  template   String
  subject    String
  status     EmailStatus @default(PENDING)
  providerId String?
  metadata   Json?
  sentAt     DateTime?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model Chapter {
  id             String              @id @default(cuid())
  subjectId      String
  name           String
  nameMr         String?
  slug           String
  sortOrder      Int                 @default(0)
  active         Boolean             @default(true)
  subject        Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics         Topic[]
  questions      Question[]
  resultChapters ExamResultChapter[]

  @@unique([subjectId, slug])
}

model QuestionTag {
  id        String           @id @default(cuid())
  name      String           @unique
  questions QuestionTagMap[]
}

model QuestionTagMap {
  questionId String
  tagId      String
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        QuestionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
}

model QuestionBankQuestion {
  id             String             @id @default(cuid())
  questionId     String
  organizationId String?
  source         String             @default("PLATFORM")
  difficulty     QuestionDifficulty @default(MEDIUM)
  explanation    String?
  explanationMr  String?
  isApproved     Boolean            @default(false)
  createdById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  question       Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([questionId])
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model ExamDraft {
  id                   String              @id @default(cuid())
  organizationId       String?
  createdById          String
  title                String
  description          String?
  examType             String?
  language             String              @default("both")
  durationMinutes      Int
  totalMarks           Float               @default(0)
  totalQuestions       Int                 @default(0)
  negativeMarking      Boolean             @default(false)
  defaultNegativeMarks Float               @default(0)
  passingScore         Float?
  fullscreenRequired   Boolean             @default(true)
  randomizeQuestions   Boolean             @default(false)
  randomizeOptions     Boolean             @default(false)
  instructions         Json?
  status               DraftStatus         @default(DRAFT)
  step                 Int                 @default(1)
  settings             Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  organization         Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy            User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  questions            ExamDraftQuestion[]
  batches              ExamDraftBatch[]
  students             ExamDraftStudent[]
}

model ExamDraftQuestion {
  id            String    @id @default(cuid())
  draftId       String
  questionId    String
  order         Int
  marks         Float     @default(1)
  negativeMarks Float     @default(0)
  source        String    @default("MANUAL")
  draft         ExamDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([draftId, questionId])
}

model ExamDraftBatch {
  draftId String
  batchId String
  draft   ExamDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  batch   Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([draftId, batchId])
}

model ExamDraftStudent {
  draftId   String
  studentId String
  draft     ExamDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  student   User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([draftId, studentId])
}

enum DraftStatus {
  DRAFT
  READY
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model ExamNotification {
  id          String                     @id @default(cuid())
  examId      String
  userId      String
  type        ExamNotificationType
  scheduledAt DateTime?
  sentAt      DateTime?
