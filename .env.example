# ==============================================================================
# MAHAEXAM PRODUCTION & VERCEL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# Copy this file to .env.local for local testing or populate these key-value pairs
# in your Vercel Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. DATABASE & PRISMA ORM CONFIGURATION (PostgreSQL / Supabase / Aiven)
# ------------------------------------------------------------------------------
# Pooled database connection string for serverless function queries
DATABASE_URL="postgresql://user:password@db-host.com:6543/dbname?pgboiler=true&sslmode=require"

# Failover Secondary / Shadow Database (Automatic Zero-Downtime Failover & Dual-Sync)
SECONDARY_DATABASE_URL="postgresql://user:password@shadow-db-host.com:6543/dbname?sslmode=require"

# Direct connection string for Prisma migrations (optional for Supabase/Neon)
DIRECT_URL="postgresql://user:password@db-host.com:5432/dbname?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APP SITE METADATA & ENVIRONMENT
# ------------------------------------------------------------------------------
# Primary domain URL (e.g. https://mahaexam.in)
NEXT_PUBLIC_APP_URL="https://mahaexam.in"
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (JOSE / JWT SESSION)
# ------------------------------------------------------------------------------
# Strong 32+ character random secret key for signing JWT user session tokens
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-strong-32-char-random-secret-key-here"
AUTH_COOKIE_NAME="mahaexam_session"

# Internal API Authorization Secret for background jobs & cron triggers
# Include in request header: Authorization: Bearer <INTERNAL_CRON_SECRET>
INTERNAL_CRON_SECRET="generate-a-random-cron-secret-key-here"

# ------------------------------------------------------------------------------
# 4. WEB PUSH NOTIFICATIONS (VAPID KEYS)
# ------------------------------------------------------------------------------
# Generate VAPID Keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY_HERE"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY_HERE"
VAPID_SUBJECT="mailto:support@mahaexam.in"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (RAZORPAY INTEGRATION)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
DEFAULT_LINKED_ACCOUNT_PAN="AAAAA0000A"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL NOTIFICATIONS (SMTP / RESEND)
# ------------------------------------------------------------------------------
ENABLE_EMAIL=true
EMAIL_PROVIDER="SMTP" # "SMTP" or "RESEND"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM='"MahaExam Portal" <noreply@mahaexam.in>'

# Resend Alternative (Optional)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="MahaExam <noreply@mahaexam.in>"

# ------------------------------------------------------------------------------
# 7. SUPABASE / S3 STORAGE & ASSET MANAGEMENT (OPTIONAL)
# ------------------------------------------------------------------------------
ENABLE_OBJECT_STORAGE=false
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="mahaexam"
